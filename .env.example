# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
# 注意：本项目以 .env 为唯一配置源（各入口均 load_dotenv(override=True)），
# 系统环境变量中的同名变量会被本文件覆盖，请勿两处重复设置。
DEEPSEEK_API_KEY=your-api-key-here

# HuggingFace 镜像（国内用户建议设置）
# 默认：不设置（从 huggingface.co 直连）
# 推荐镜像：https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# ── 本地模型存放路径 ──────────────────────────────────────
# 本地模型必须先用预装脚本一次性下载（约 3.2GB 文件 + 等量下载流量）：
#     python scripts/download_models.py
# 主程序启动时会检查这些模型是否就位，未就绪则暂停全部功能并提示执行该脚本。
#
# 不设置这两项时使用默认路径（均在 C 盘用户目录，数 GB 文件会占用系统盘）：
#     HF_HOME               默认 %USERPROFILE%\.cache\huggingface
#     PADDLE_PDX_CACHE_HOME 默认 %USERPROFILE%\.paddlex
# 如需改到其他分区，取消下面两行的注释并改成实际路径。
# 注意：刻意写成注释而非留空赋值——"HF_HOME=" 会让 huggingface_hub 把缓存
# 目录算成相对路径 hub/，把数 GB 模型下载进项目目录。
# HF_HOME=E:\models\huggingface
# PADDLE_PDX_CACHE_HOME=E:\models\paddlex

# Python 控制台编码。
# Windows 下默认跟随系统代码页（中文系统为 gbk），打印非 GBK 字符（如 ✓、emoji）
# 会抛 UnicodeEncodeError，设为 utf-8 可避免。
# 注意：此变量只在 Python 进程启动前生效。仅靠本文件（运行时加载）无效，
# 需配合 VSCode 的 python.terminal.useEnvFile=true（或系统环境变量）才能生效。
PYTHONIOENCODING=utf-8
